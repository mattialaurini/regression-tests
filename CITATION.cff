    family-names: "Schiavo"
  - given-names: "Antonio"
    family-names: "Visioli"
keywords:
  - separable nonlinear regression
  - branch-and-bound
  - pharmacokinetic/pharmacodynamic identification
  - NIST benchmarks
  - reproducibility
